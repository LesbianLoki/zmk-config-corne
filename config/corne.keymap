#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    macros {
        ctrlaltdel: ctrlaltdel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_ALT &kp DEL>,
                <&macro_release>;

            label = "CTRLALTDEL";
        };

        task_mgr: task_mgr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp ESCAPE>,
                <&macro_release>;

            label = "TASK_MGR";
        };

        all: all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp A>,
                <&macro_release>;

            label = "ALL";
        };

        save: save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp S>,
                <&macro_release>;

            label = "SAVE";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp V>,
                <&macro_release>;

            label = "PASTE";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp X>,
                <&macro_release>;

            label = "CUT";
        };

        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp Z>,
                <&macro_release>;

            label = "UNDO";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp C>,
                <&macro_release>;

            label = "COPY";
        };

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp Y>,
                <&macro_release>;

            label = "REDO";
        };

        saveas: saveas {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp S>,
                <&macro_release>;

            label = "SAVEAS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
            //                    | GUI | LWR | ENT |   | SPC | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LEFT_SHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_ALT
                              &kp LGUI  &sl 0  &kp SPACE    &lt 2 SPACE  &sl 0  &kp RET
            >;
        };

        lower_layer {
            bindings = <
&kp ESCAPE      &kp CAPS      &none  &none         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp MINUS    &kp N7        &kp N8        &kp N9        &kp N0     &kp BACKSPACE
&kp LEFT_SHIFT  &kp DELETE    &none  &none         &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp UNDER    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS   &kp MINUS
&kp RCTRL       &kp LEFT_ALT  &none  &none         &kp LEFT_BRACE        &kp RIGHT_BRACE          &none        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &kp KP_DOT
                                     &kp LEFT_GUI  &sl 1                 &kp SPACE                &lt 2 SPACE  &sl 1         &kp ENTER
            >;
        };

        keyfunc_layer {
            bindings = <
&kp ESCAPE       &kp CAPSLOCK     &kp F1  &kp F2        &kp F3   &kp F4       &kp HOME     &kp UP_ARROW  &kp PAGE_UP    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_COLOR_HSB(268,100,50)
&kp PRINTSCREEN  &kp PAUSE_BREAK  &kp F5  &kp F6        &kp F7   &kp F8       &kp LEFT     &trans        &kp RIGHT      &sys_reset       &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(330,100,50)
&kp HOME         &kp END          &kp F9  &kp F10       &kp F11  &kp F12      &kp END      &kp DOWN      &kp PAGE_DOWN  &bootloader      &rgb_ug RGB_SPD  &rgb_ug RGB_COLOR_HSB(0,100,50)
                                          &kp LEFT_GUI  &sl 1    &kp SPACE    &lt 2 SPACE  &sl 1         &kp ENTER
            >;
        };
    };
};
