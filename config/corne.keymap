#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    macros {
        ctrlaltdel: ctrlaltdel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_ALT &kp DEL>,
                <&macro_release>;

            label = "CTRLALTDEL";
        };

        task_mgr: task_mgr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp ESCAPE>,
                <&macro_release>;

            label = "TASK_MGR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
            //                    | GUI | LWR | ENT |   | SPC | RSE  | ALT |

            bindings = <
&kp TAB           &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LEFT_CONTROL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT         &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                                &kp LGUI  &sl 1  &kp SPACE    &kp SPACE  &sl 2  &kp RET
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1    |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | LCTRL| BTCLR | BT0 | BT1 | BT2 | BT3 |   | LFT | DWN |  UP | RGT |     |      |
            // | ESC  |       | HOME| PGUP| PGDN| END |   |     |     |     |     |     |      |
            //                      | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp CAPS          &kp MINUS  &kp AMPS         &kp STAR      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp KP_SLASH  &kp N7  &kp N8     &kp N9  &kp N0                 &kp DEL
&kp LEFT_CONTROL  &kp UNDER  &kp DOLLAR       &kp PERCENT   &kp DOLLAR            &kp KP_EQUAL             &kp CARET     &kp N4  &kp N5     &kp N6  &kp RIGHT_PARENTHESIS  &kp LESS_THAN
&kp ESC           &kp PLUS   &kp EXCLAMATION  &kp AT        &kp HASH              &kp PIPE                 &kp N0        &kp N1  &kp N2     &kp N3  &kp PERIOD             &kp GREATER_THAN
                                              &kp LEFT_GUI  &sl 1                 &kp SPACE                &kp SPACE     &sl 2   &kp ENTER
            >;
        };

        raise_layer {
            bindings = <
&kp F1   &kp F2           &kp F3  &kp F4        &kp F5  &kp F6       &kp F7     &kp F8  &kp F9     &kp F10  &kp F11  &kp F12
&kp ESC  &kp PRINTSCREEN  &trans  &trans        &trans  &trans       &trans     &trans  &trans     &trans   &trans   &task_mgr
&kp TAB  &kp C_PAUSE      &trans  &trans        &trans  &trans       &sl 3      &trans  &trans     &trans   &trans   &ctrlaltdel
                                  &kp LEFT_WIN  &sl 1   &kp SPACE    &kp SPACE  &sl 2   &kp ENTER
            >;
        };

        keyfunc_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_COLOR_HSB(258,100,50)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(280,100,50)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_COLOR_HSB(307,100,50)  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans           &trans           &trans
            >;
        };
    };
};
