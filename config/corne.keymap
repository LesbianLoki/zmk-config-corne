#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    macros {
        ctrlaltdel: ctrlaltdel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_ALT &kp DEL>,
                <&macro_release>;

            label = "CTRLALTDEL";
        };

        task_mgr: task_mgr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp ESCAPE>,
                <&macro_release>;

            label = "TASK_MGR";
        };

        all: all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp A>,
                <&macro_release>;

            label = "ALL";
        };

        save: save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp S>,
                <&macro_release>;

            label = "SAVE";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp V>,
                <&macro_release>;

            label = "PASTE";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp X>,
                <&macro_release>;

            label = "CUT";
        };

        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp Z>,
                <&macro_release>;

            label = "UNDO";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp C>,
                <&macro_release>;

            label = "COPY";
        };

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp Y>,
                <&macro_release>;

            label = "REDO";
        };

        saveas: saveas {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT &kp S>,
                <&macro_release>;

            label = "SAVEAS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
            //                    | GUI | LWR | ENT |   | SPC | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LEFT_SHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_CONTROL
                              &kp LGUI  &sl 1  &kp SPACE    &kp SPACE  &sl 2  &kp RET
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1    |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | LCTRL| BTCLR | BT0 | BT1 | BT2 | BT3 |   | LFT | DWN |  UP | RGT |     |      |
            // | ESC  |       | HOME| PGUP| PGDN| END |   |     |     |     |     |     |      |
            //                      | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE      &kp CAPSLOCK  &kp AMPS         &kp STAR      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp K_CALC  &kp N7  &kp N8     &kp N9  &kp SLASH   &kp MINUS
&kp LEFT_SHIFT  &kp HOME      &kp DOLLAR       &kp PERCENT   &kp CARET             &kp LEFT_BRACKET         &kp UNDER   &kp N4  &kp N5     &kp N6  &kp STAR    &kp PLUS
&kp LCTRL       &kp END       &kp EXCLAMATION  &kp AT        &kp HASH              &kp RIGHT_BRACKET        &kp N0      &kp N1  &kp N2     &kp N3  &kp PERIOD  &kp ENTER
                                               &kp LEFT_GUI  &sl 1                 &kp SPACE                &kp SPACE   &sl 2   &kp ENTER
            >;
        };

        raise_layer {
            bindings = <
&kp ESCAPE    &kp F2  &kp F3  &kp F4        &kp F5  &kp F6       &redo      &kp INS   &kp UP_ARROW  &kp DELETE  &trans           &saveas
&kp CAPSLOCK  &all    &save   &trans        &trans  &trans       &trans     &kp LEFT  &sl 3         &kp RIGHT   &kp C_PAUSE      &task_mgr
&kp LCTRL     &undo   &cut    &copy         &paste  &trans       &trans     &trans    &kp DOWN      &trans      &kp PRINTSCREEN  &ctrlaltdel
                              &kp LEFT_WIN  &sl 1   &kp SPACE    &kp SPACE  &sl 2     &kp ENTER
            >;
        };

        keyfunc_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_COLOR_HSB(258,100,50)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(280,100,50)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_COLOR_HSB(307,100,50)  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans           &trans           &trans
            >;
        };
    };
};
